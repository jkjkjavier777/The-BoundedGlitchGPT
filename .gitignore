# This is a gitignore template file
# 
# HOW TO USE THIS:
# 1. Download this file
# 2. Rename it to ".gitignore" (remove the _rules.txt part)
# 3. Place it in your repository root
# 4. Git will now ignore the patterns listed below
#
# If you can't rename it, you can also:
# - Copy the contents and run: echo "$(cat gitignore_rules.txt)" > .gitignore
# - Or use your Git GUI to create a .gitignore with these contents


# ============================================================================
# DATA (usually large files)
# ============================================================================
data/
!data/.gitkeep
*.txt
*.csv
*.json
*.jsonl


# ============================================================================
# MODEL CHECKPOINTS & WEIGHTS (large files)
# ============================================================================
checkpoints/
saves/
models/
*.pt
*.pth
*.bin
weights/
.weights/


# ============================================================================
# PYTHON & VIRTUAL ENVIRONMENTS
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv
.env
.env.local


# ============================================================================
# IDE & EDITOR FILES
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/
*.iml


# ============================================================================
# LOGS & MONITORING
# ============================================================================
logs/
*.log
tensorboard_logs/
runs/
wandb/
.wandb/
lightning_logs/


# ============================================================================
# TEST & COVERAGE
# ============================================================================
.pytest_cache/
.coverage
htmlcov/
.tox/
*.cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json


# ============================================================================
# OUTPUTS & RESULTS
# ============================================================================
outputs/
results/
generated_texts/
*.png
*.jpg
*.jpeg
*.pdf
test_output/


# ============================================================================
# OS FILES
# ============================================================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
*.tmp
.fuse_hidden*


# ============================================================================
# JUPYTER & NOTEBOOKS
# ============================================================================
.ipynb_checkpoints/
*.ipynb
*/.ipynb_checkpoints/


# ============================================================================
# MISC
# ============================================================================
.cache/
.tmp/
temp/
*.bak
*.backup__pycache__/
*.pyc
*.npy
